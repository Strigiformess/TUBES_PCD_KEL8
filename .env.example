# ============================================
# FRESHCHECK APP - ENVIRONMENT VARIABLES
# ============================================
# Copy file ini ke .env dan sesuaikan dengan konfigurasi Anda

# ==========================================
# Backend API Configuration
# ==========================================
# Base URL untuk backend API
API_BASE_URL=http://localhost:3000/api

# Timeout untuk API requests (dalam detik)
API_TIMEOUT=30

# ==========================================
# MongoDB Configuration
# ==========================================
# MongoDB connection string (jika diperlukan)
MONGODB_URI=mongodb://localhost:27017/freshcheck

# ==========================================
# Feature Flags
# ==========================================
# Enable/disable backend sync
ENABLE_BACKEND_SYNC=true

# Enable/disable PCD (Point Cloud Detection) features
ENABLE_PCD_FEATURES=true

# ==========================================
# Debug Settings
# ==========================================
# Debug mode (true/false)
DEBUG_MODE=false

# Log level (info, debug, warning, error)
LOG_LEVEL=info

# ==========================================
# App Configuration
# ==========================================
# Maximum retry count untuk failed sync
MAX_RETRY_COUNT=3

# Interval sync otomatis (dalam menit)
SYNC_INTERVAL_MINUTES=15

# ==========================================
# NOTES
# ==========================================
# - Jangan commit file .env ke git (sudah ada di .gitignore)
# - Gunakan .env.example sebagai template
# - Sesuaikan nilai dengan environment Anda (dev/staging/prod)
